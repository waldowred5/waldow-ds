[
  {
    "name": "@waldow-design/ui: all components",
    "path": "packages/ui/src/index.ts",
    "import": "*",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "45 kB"
  },
  {
    "name": "@waldow-design/ui: Button only (tree-shaking)",
    "path": "packages/ui/src/index.ts",
    "import": "{ Button }",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "11 kB"
  },
  {
    "name": "@waldow-design/tokens: tokens.css",
    "path": "packages/tokens/dist/tokens.css",
    "limit": "3 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: JS",
    "path": "apps/web/dist/assets/*.js",
    "limit": "110 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: CSS",
    "path": "apps/web/dist/assets/*.css",
    "limit": "7 kB",
    "rolldown": false
  }
]
