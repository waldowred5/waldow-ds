{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.neutral.950}"
      },
      "subtle": {
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$value": "{color.neutral.800}"
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.neutral.900}"
      },
      "raised": {
        "$value": "{color.neutral.800}"
      },
      "overlay": {
        "$value": "#000000b3"
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$value": "{color.neutral.400}"
      },
      "disabled": {
        "$value": "{color.neutral.600}"
      },
      "inverse": {
        "$value": "{color.neutral.900}"
      },
      "link": {
        "$value": "{color.primary.300}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.700}"
      },
      "strong": {
        "$value": "{color.neutral.500}"
      },
      "focus": {
        "$value": "{color.primary.400}"
      }
    },
    "action": {
      "primary": {
        "default": {
          "$value": "{color.primary.400}"
        },
        "hover": {
          "$value": "{color.primary.300}"
        },
        "text": {
          "$value": "{color.neutral.950}"
        }
      },
      "secondary": {
        "default": {
          "$value": "{color.secondary.900}"
        },
        "hover": {
          "$value": "{color.secondary.800}"
        },
        "text": {
          "$value": "{color.secondary.100}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.400}"
        },
        "hover": {
          "$value": "{color.red.300}"
        },
        "text": {
          "$value": "{color.neutral.950}"
        }
      }
    },
    "emphasis": {
      "highlight": {
        "solid": {
          "$value": "{color.highlight.400}",
          "$description": "Filled highlight: markers, progress, chart emphasis."
        },
        "solid-hover": {
          "$value": "{color.highlight.300}"
        },
        "on-solid": {
          "$value": "{color.neutral.950}"
        },
        "background": {
          "$value": "{color.highlight.900}"
        },
        "text": {
          "$value": "{color.highlight.200}"
        },
        "border": {
          "$value": "{color.highlight.700}"
        }
      }
    },
    "status": {
      "success": {
        "background": {
          "$value": "{color.green.950}"
        },
        "text": {
          "$value": "{color.green.300}"
        },
        "border": {
          "$value": "{color.green.800}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.950}"
        },
        "text": {
          "$value": "{color.amber.300}"
        },
        "border": {
          "$value": "{color.amber.800}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.950}"
        },
        "text": {
          "$value": "{color.red.300}"
        },
        "border": {
          "$value": "{color.red.800}"
        }
      },
      "info": {
        "background": {
          "$value": "{color.blue.950}"
        },
        "text": {
          "$value": "{color.blue.300}"
        },
        "border": {
          "$value": "{color.blue.800}"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "raised": {
      "$value": "{shadow.dark.sm}"
    },
    "floating": {
      "$value": "{shadow.dark.md}"
    },
    "overlay": {
      "$value": "{shadow.dark.lg}"
    }
  }
}
