{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.white}"
      },
      "subtle": {
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$value": "{color.neutral.100}"
      },
      "inverse": {
        "$value": "{color.neutral.900}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.white}"
      },
      "raised": {
        "$value": "{color.white}"
      },
      "overlay": {
        "$value": "#0e111680"
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$value": "{color.neutral.600}"
      },
      "disabled": {
        "$value": "{color.neutral.400}"
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      },
      "link": {
        "$value": "{color.primary.600}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.200}"
      },
      "strong": {
        "$value": "{color.neutral.500}"
      },
      "focus": {
        "$value": "{color.primary.500}"
      }
    },
    "action": {
      "primary": {
        "default": {
          "$value": "{color.primary.600}"
        },
        "hover": {
          "$value": "{color.primary.700}"
        },
        "text": {
          "$value": "{color.white}"
        }
      },
      "secondary": {
        "default": {
          "$value": "{color.secondary.100}"
        },
        "hover": {
          "$value": "{color.secondary.200}"
        },
        "text": {
          "$value": "{color.secondary.900}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.600}"
        },
        "hover": {
          "$value": "{color.red.700}"
        },
        "text": {
          "$value": "{color.white}"
        }
      }
    },
    "emphasis": {
      "highlight": {
        "solid": {
          "$value": "{color.highlight.600}",
          "$description": "Filled highlight: markers, progress, chart emphasis."
        },
        "solid-hover": {
          "$value": "{color.highlight.700}"
        },
        "on-solid": {
          "$value": "{color.white}"
        },
        "background": {
          "$value": "{color.highlight.100}"
        },
        "text": {
          "$value": "{color.highlight.800}"
        },
        "border": {
          "$value": "{color.highlight.300}"
        }
      }
    },
    "status": {
      "success": {
        "background": {
          "$value": "{color.green.50}"
        },
        "text": {
          "$value": "{color.green.700}"
        },
        "border": {
          "$value": "{color.green.200}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.50}"
        },
        "text": {
          "$value": "{color.amber.800}"
        },
        "border": {
          "$value": "{color.amber.200}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.50}"
        },
        "text": {
          "$value": "{color.red.700}"
        },
        "border": {
          "$value": "{color.red.200}"
        }
      },
      "info": {
        "background": {
          "$value": "{color.blue.50}"
        },
        "text": {
          "$value": "{color.blue.700}"
        },
        "border": {
          "$value": "{color.blue.200}"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "raised": {
      "$value": "{shadow.sm}"
    },
    "floating": {
      "$value": "{shadow.md}"
    },
    "overlay": {
      "$value": "{shadow.lg}"
    }
  }
}
