{
  "button": {
    "height": {
      "$type": "dimension",
      "sm": {
        "$value": "{size.8}"
      },
      "md": {
        "$value": "{size.9}"
      },
      "lg": {
        "$value": "{size.11}"
      }
    },
    "padding-x": {
      "$type": "dimension",
      "sm": {
        "$value": "{space.3}"
      },
      "md": {
        "$value": "{space.4}"
      },
      "lg": {
        "$value": "{space.6}"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    }
  },
  "input": {
    "height": {
      "$type": "dimension",
      "$value": "{size.9}"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.strong}"
    }
  },
  "checkbox": {
    "size": {
      "$type": "dimension",
      "$value": "{size.4}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    }
  },
  "card": {
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{elevation.raised}"
    }
  },
  "badge": {
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.pill}"
    }
  },
  "dialog": {
    "width": {
      "$type": "dimension",
      "$value": "{size.md}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{elevation.overlay}"
    }
  },
  "table": {
    "cell-padding-x": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "cell-padding-y": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "row-hover": {
      "$type": "color",
      "$value": "{color.background.subtle}"
    }
  }
}
