{
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "#0e11160f"
      }
    },
    "md": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px",
          "color": "#0e11161a"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px",
          "color": "#0e11160f"
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "32px",
          "spread": "-8px",
          "color": "#0e111633"
        },
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-4px",
          "color": "#0e11161a"
        }
      ]
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "normal": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  }
}
