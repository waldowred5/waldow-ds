{
  "name": "waldow-ds-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @waldow-ds/web dev",
    "build": "pnpm -r run build",
    "lint": "oxlint && node scripts/check-tokens.mjs",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm size",
    "storybook": "pnpm --filter @waldow-ds/ui storybook",
    "test": "pnpm -r run test",
    "size": "size-limit",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.3.0",
    "oxlint": "^1.91.0",
    "size-limit": "^14.3.0",
    "typescript": "~7.0.2"
  }
}
